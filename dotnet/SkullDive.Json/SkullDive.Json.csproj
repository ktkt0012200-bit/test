<Project Sdk="Microsoft.NET.Sdk">

  <!--
    System.Text.Json による参照実装。テスト専用。

    本番の通信は WireCodec (手書き・リフレクション非依存) が担当する。
    こちらは「WireCodec の出力が標準的なシリアライザと同じ形か」を突き合わせる
    独立した検証用オラクルとしてのみ使う。
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>SkullDive.Json</AssemblyName>
    <RootNamespace>SkullDive.Json</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../SkullDive.Shared/SkullDive.Shared.csproj" />
  </ItemGroup>

</Project>
