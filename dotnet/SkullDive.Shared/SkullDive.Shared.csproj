<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unity プロジェクト内の共有ソースをそのままコンパイルする。
    ソースの正本は unity/SkullDive/Assets/SkullDive/{Core,Ai,Net} の 1 か所だけで、
    Unity・サーバ・テストはすべて同じファイルを見る(コピーは存在しない)。

    Game/ と Editor/ は UnityEngine に依存するため意図的に含めていない。
  -->

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Unity が対応する C# バージョンに合わせる。ここを上げると Unity 側でコンパイルが通らなくなる。 -->
    <LangVersion>9.0</LangVersion>
    <AssemblyName>SkullDive.Shared</AssemblyName>
    <RootNamespace>SkullDive</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../unity/SkullDive/Assets/SkullDive/Core/**/*.cs" LinkBase="Core" />
    <Compile Include="../../unity/SkullDive/Assets/SkullDive/Ai/**/*.cs" LinkBase="Ai" />
    <Compile Include="../../unity/SkullDive/Assets/SkullDive/Net/**/*.cs" LinkBase="Net" />
  </ItemGroup>

</Project>
